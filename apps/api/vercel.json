{
  "version": 2,
  "github": {
    "enabled": false
  },
  "builds": [
    {
      "src": "dist/main.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/main.js"
    }
  ],
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/drops/cron/transition",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/health",
      "schedule": "*/4 * * * *"
    }
  ]
}
