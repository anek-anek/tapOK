{
  "version": 2,
  "github": {
    "enabled": false
  },
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts"
    }
  ],
  "crons": [
    {
      "path": "/drops/cron/transition",
      "schedule": "0 0 * * *"
    }
  ]
}
