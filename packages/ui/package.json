{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./utils": "./src/utils/utils.ts",
    "./*": "./src/*.tsx"
  },
  "typesVersions": {
    "*": {
      "utils": ["./src/utils/utils.ts"],
      "components/ui/*": ["./src/components/ui/*.tsx"],
      "*": ["./src/*.tsx"]
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "shadcn": "^4.2.0",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "eslint": "^9.31.0",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0"
  }
}
