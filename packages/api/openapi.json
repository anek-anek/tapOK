          "drops"
        ]
      }
    },
    "/drops/{id}/crew/{userId}/reject": {
      "patch": {
        "operationId": "DropsController_rejectPendingMember",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Join request rejected."
          },
          "400": {
            "description": "User is not pending approval."
          },
          "403": {
            "description": "Only the organiser can reject join requests."
          },
          "404": {
            "description": "Drop or crew member not found."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Reject a pending join request (organiser only)",
        "tags": [
          "drops"
        ]
      }
    },
    "/drops/{id}/crew/{userId}/remove": {
      "patch": {
        "operationId": "DropsController_removeCrewMember",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Crew member removed."
          },
          "400": {
            "description": "User is not an active crew member."
          },
          "403": {
            "description": "Only the organiser can remove crew members."
          },
          "404": {
            "description": "Drop or crew member not found."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Remove an active crew member (organiser only)",
        "tags": [
          "drops"
        ]
      }
    }
